{
  "name": "live-update-provider-mock",
  "version": "0.1.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "capacitor": {
    "ios": {
      "src": "ios/Sources/LiveUpdateProviderMockPlugin"
    },
    "android": {
      "src": "android/mock-live-update-provider"
    }
  },
  "scripts": {
    "build": "tsc",
    "build:webapp": "cd webapp && npm run build:portals && npm run build:fedcap",
    "bundle:android": "npm run build:webapp && node scripts/bundle-android-assets.js",
    "build:android": "cd android && ./gradlew build",
    "sync:android": "npm run bundle:android && npm run build:android"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8"
  },
  "devDependencies": {
    "typescript": "^6.0.2"
  }
}